  "negative": [
    {
      "id": "ea-fail-01-grade-in-producer-record",
      "description": "THE GRADE-LOCATION DISCRIMINATOR. An appraisal artifact cites its subject by typed digest (subject_record.record_id + subject_record.digest) and carries the verified grade in e_grade. A producer record that stamps its own appraisal-grade inside its digest-committed payload is a category error: the label is an output of appraisal, never a field the producer stamps. This pins the RATS split (evidence in, appraisal is the bridge, attestation out) that the producer artifact type deliberately does not satisfy.",
      "expected": "An evidence-record MUST NOT contain an evidence-appraisal's e_grade semantics as a producer stamp; appraisals are separate verifier artifacts bound by digest. See evidence-appraisal schema discipline rule 1."
    },
    {
      "id": "ea-fail-02-unregistered-grade",
      "description": "e_grade is E0-E4 only. An appraisal concluding \"E5\" MUST be rejected.",
      "input": {
        "schema_version": "0.1.0",
        "appraisal_id": "ea-fail-02",
        "subject_record": {
          "record_id": "er-00003",
          "digest": "c65a52c39246a73f58f4d185b104ba1c1237e25198c5b5deeab1de77e80232a1"
        },
        "e_grade": "E5",
        "claim_type": "operationally-conformant",
        "reconciliation_state": "agreement",
        "verifier_id": "verifier-alpha",
        "timestamp": "2026-08-28T11:30:00+00:00",
        "signed": true
      },
      "expected": "REJECT (e_grade not in [E0, E1, E2, E3, E4])"
    },
    {
      "id": "ea-fail-03-unregistered-claim-type",
      "description": "claim_type is exactly emission-conformant | operationally-conformant. Unknown value MUST be rejected.",
      "input": {
        "schema_version": "0.1.0",
        "appraisal_id": "ea-fail-03",
        "subject_record": {
          "record_id": "er-00003",
          "digest": "c65a52c39246a73f58f4d185b104ba1c1237e25198c5b5deeab1de77e80232a1"
        },
        "e_grade": "E4",
        "claim_type": "maybe-conformant",
        "reconciliation_state": "agreement",
        "verifier_id": "verifier-alpha",
        "timestamp": "2026-08-28T11:30:00+00:00",
        "signed": true
      },
      "expected": "REJECT (claim_type not in [emission-conformant, operationally-conformant])"
    },
    {
      "id": "ea-fail-04-subject-digest-not-bare-hex",
      "description": "subject_record.digest is exactly [0-9a-f]{64}. Prefixed or uppercase forms MUST be rejected.",
      "input": {
        "schema_version": "0.1.0",
        "appraisal_id": "ea-fail-04",
        "subject_record": {
          "record_id": "er-00003",
          "digest": "sha256:c65a52c39246a73f58f4d185b104ba1c1237e25198c5b5deeab1de77e80232a1"
        },
        "e_grade": "E4",
        "claim_type": "operationally-conformant",
        "reconciliation_state": "agreement",
        "verifier_id": "verifier-alpha",
        "timestamp": "2026-08-28T11:30:00+00:00",
        "signed": true
      },
      "expected": "REJECT (digest fails [0-9a-f]{64})"
    },
    {
      "id": "ea-fail-05-mutation-probe-single-byte",
      "description": "A single-byte mutation of a valid appraisal changes the digest. Pins the content address.",
      "input_file": "samples/ea-00001-e4-agreement.json",
      "mutation": "flip the verifier_id first character",
      "must_not_equal": "ea-kat-01-e4-agreement.expected_digest_bare_hex"
    }
  ]
}
